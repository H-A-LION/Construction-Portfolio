    "type": "project",
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.9",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.4",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
